# Copy to `.env` and adjust. All values shown here match the recommended
# defaults; the deployment reads these from the environment.

# --- application -----------------------------------------------------------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- model registry (consumed read-only) ------------------------------------
# Point at the MLflow tracking DB bundled with the image. Never change the
# Production model here: the service only reads it.
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow_tracking.db
MLFLOW_MODEL_NAME=demand_forecasting_final
# Pin a specific registered version. If empty/unset, MLFLOW_MODEL_ALIAS is used.
MLFLOW_MODEL_VERSION=2
# Alias used only when MLFLOW_MODEL_VERSION is unset.
MLFLOW_MODEL_ALIAS=Production
MLFLOW_MLRUNS_DIR=mlruns

# --- forecasting / explainability -------------------------------------------
REFERENCE_WEEK=2018-05-14
SHAP_BACKGROUND_SIZE=400
SHAP_EXPLAIN_SIZE=1500
SHAP_SEED=20260924
SHAP_TOP_N=20

# --- persistence -------------------------------------------------------------
# PostgreSQL in production (docker-compose). SQLite is fine for a local run.
DATABASE_URL=postgresql+psycopg2://inference:inference@db:5432/inference
# DATABASE_URL=sqlite:///./artifacts/inference_log.db
PERSISTENCE_TIMEOUT_S=5

# --- network ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502
STREAMLIT_API_BASE_URL=http://localhost:8000
MAX_PAYLOAD_BYTES=65536
REQUEST_ID_HEADER=X-Request-ID

# --- optional rate limiting (default off) --------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Docker Command : docker compose -f deployment/docker-compose.yml up --build